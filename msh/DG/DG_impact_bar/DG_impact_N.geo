// 关闭自动几何合并（全局生效）
Geometry.AutoCoherence = 0;

a = 1.0;
b = 2.0;
N = 4;       // <-- 层数 / 间断数（可修改）
// 注意：gmsh 的 Transfinite 数的是「节点数」，单元数 = 减 1。
// 要让时空单元是正方形（Δx = Δy，从而对角线正好 45°、与特征线 x±t=const 平行），
// x 方向要有 32 个单元、每层竖直方向 16 个单元 → 节点数 33 / 17。
nelx = 33;   // 每层水平方向单元数 32
nely = 17;   // 每层竖直方向单元数 16

// ==============================================
// 点定义：每层使用独立的点（不共享界面点）
// ==============================================
point_idx = 1;
For k In {0:N-1}
  y0 = k * b / N;
  y1 = (k + 1) * b / N;

  Point(point_idx)     = {0,     y0, 0};   // 左下
  Point(point_idx+1)   = {a,     y0, 0};   // 右下
  Point(point_idx+2)   = {a,     y1, 0};   // 右上
  Point(point_idx+3)   = {0,     y1, 0};   // 左上

  point_idx = point_idx + 4;
EndFor

// ==============================================
// 线定义（每层独立，不共享界面点）
// ==============================================
line_idx = 1;
For k In {0:N-1}
  p0 = 4*k+1;    p1 = 4*k+2;    p2 = 4*k+3;    p3 = 4*k+4;

  Line(line_idx)      = {p0, p1};   // 底边
  Line(line_idx+1)    = {p1, p2};   // 右边
  Line(line_idx+2)    = {p2, p3};   // 顶边
  Line(line_idx+3)    = {p3, p0};   // 左边

  line_idx = line_idx + 4;
EndFor

// ==============================================
// 曲线环 & 面
// ==============================================
For k In {0:N-1}
  l0 = 4*k+1;  l1 = 4*k+2;  l2 = 4*k+3;  l3 = 4*k+4;
  Curve Loop(k+1) = {l0, l1, l2, l3};
  Plane Surface(k+1) = {k+1};
EndFor

// ==============================================
// 结构化网格划分
// ==============================================
For k In {0:N-1}
  l0 = 4*k+1;  l1 = 4*k+2;  l2 = 4*k+3;  l3 = 4*k+4;
  Transfinite Curve{l0} = nelx;
  Transfinite Curve{l2} = nelx;
  Transfinite Curve{l1} = nely;
  Transfinite Curve{l3} = nely;
EndFor

// ==============================================
// 对角线方向：让对角线平行于该层内的特征线
//   第 0 ~ N/2-1 层的波前是 x = t     （斜率 +1）→ Right
//   第 N/2 ~ N-1 层的波前是 x + t = T （斜率 -1）→ Left
// σ 是分片常数、间断正好落在波前上；只有单元边与波前重合，
// P1 格式才能把阶跃表示干净，否则必然出现涂抹和振荡条纹。
// 注意：这个划分是针对本算例（x∈[0,1]、T=2、c=1、固定-自由）的波前位置，
//       换成别的初值/边界后需要按实际特征线重新指定。
// ==============================================
For k In {0:N-1}
  p0 = 4*k+1;  p1 = 4*k+2;  p2 = 4*k+3;  p3 = 4*k+4;
  If(k < N/2)
    Transfinite Surface{k+1} = {p0, p1, p2, p3} Right;
  Else
    Transfinite Surface{k+1} = {p0, p1, p2, p3} Left;
  EndIf
EndFor

// ==============================================
// 物理组定义
// ==============================================
// 底边 (Γ¹)：第 0 层的底边
Physical Curve("Γ¹") = {1};

// 顶边 (Γ⁵)：最后一层的顶边
Physical Curve("Γ⁵") = {4*(N-1)+3};

// 注意：gmsh 的区间写法是 {起始:结束:步长}，不是 MATLAB 的 {起始:步长:结束}

// 右边 (Γ²)：所有层的右边 [2, 6, 10, ..., 4(N-1)+2]
Physical Curve("Γ²") = {2:4*(N-1)+2:4};

// 左边 (Γ⁴)：所有层的左边 [4, 8, 12, ..., 4N]
Physical Curve("Γ⁴") = {4:4*N:4};

// 中间界面下侧 (Γ³⁻)：第 0~N-2 层的顶边 [3, 7, ..., 4(N-2)+3]
Physical Curve("Γ³⁻") = {3:4*(N-2)+3:4};

// 中间界面上侧 (Γ³⁺)：第 1~N-1 层的底边 [5, 9, ..., 4(N-1)+1]
Physical Curve("Γ³⁺") = {5:4*(N-1)+1:4};

// 合并计算域 (Ω)
Physical Surface("Ω") = {1:N};

Mesh 2;
Save "DG_impact_N4_32.msh";
